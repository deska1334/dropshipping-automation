# ==============================================================================
# CONFIGURATION DROPSHIPPING & SYSTEME ANTI-BAN
# ==============================================================================

# Mode Simulation :
# - True : Fonctionnement 100% autonome et sécurisé (test des APIs, recherche, calculs,
#          mise en vente simulée et passation de commande sans dépenser d'argent réel).
# - False : Mode réel (requiert vos clés API eBay Developer et comptes marchands).
SIMULATION_MODE=True

# --- EBAY DEVELOPER API ---
EBAY_ENVIRONMENT=SANDBOX
EBAY_APP_ID=votre_app_id
EBAY_CERT_ID=votre_cert_id
EBAY_DEV_ID=votre_dev_id
EBAY_USER_TOKEN=votre_user_token
EBAY_MARKETPLACE_ID=EBAY_FR

# --- AMAZON SUPPLIER ---
AMAZON_PAAPI_KEY=
AMAZON_PAAPI_SECRET=
AMAZON_ASSOCIATE_TAG=
AMAZON_REGION=fr

# --- ALIEXPRESS SUPPLIER ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# --- PARAMETRES DE MARGE & FRAIS ---
DEFAULT_CURRENCY=EUR
MIN_PROFIT_MARGIN_PERCENT=25.0
MIN_PROFIT_ABSOLUTE_EUR=5.00
EBAY_COMMISSION_PERCENT=12.8
EBAY_FIXED_FEE_EUR=0.35
PAYMENT_PROCESSING_FEE_PERCENT=2.5
SAFETY_PRICE_BUFFER_PERCENT=5.0

# --- ANTI-BAN & DISCRETION ALGORITHMIQUE (JITTER) ---
# Délais aléatoires entre requêtes (en secondes) pour simuler un comportement humain
DELAY_SCRAPE_MIN=4.0
DELAY_SCRAPE_MAX=12.0
DELAY_LISTING_MIN=30.0
DELAY_LISTING_MAX=90.0
DELAY_FULFILLMENT_MIN=15.0
DELAY_FULFILLMENT_MAX=45.0

# Quotas de sécurité (éviter les flags algorithmiques de nouveaux comptes eBay)
MAX_LISTINGS_PER_DAY=15
MAX_SCRAPES_PER_HOUR=60
CIRCUIT_BREAKER_COOLDOWN_SEC=900

# Proxies optionnels (séparés par des virgules)
PROXIES=
